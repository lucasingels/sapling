folly-python on darwin (macOS) — build fixes for folly/python (the folly.iobuf /
folly.executor extension modules that the thrift-python runtime needs).

Applied by getdeps via `patchfile = folly-python-darwin.patch` in
manifests/folly-python (git apply --ignore-space-change from the folly checkout
root; the folly and folly-python manifests share that checkout and the
`.getdeps_patched` sentinel). Upstream only ever built these extensions on
Linux. Everything below is guarded by if(APPLE) or is a no-op on Linux.

Hunks (all in folly/python/CMakeLists.txt):

1. Linker flags for the setup.py build_ext / bdist_wheel passes: an LDFLAGS
   environment entry (setuptools appends $LDFLAGS to LDSHARED). On darwin it
   adds -Wl,-headerpad_max_install_names and -Wl,-rpath,<prefix>/lib so the
   extension modules can resolve the @rpath/libfolly*.dylib load commands
   without DYLD_LIBRARY_PATH (which python does not inherit) and stay editable
   with install_name_tool. On Linux the variable is just the inherited LDFLAGS.

2. setup.py is run with ${Python3_EXECUTABLE} (the interpreter find_package
   chose / the one pinned via -DPython3_EXECUTABLE) instead of whichever
   `python3` is first on PATH. Same for the `pip install --prefix` step in
   install(CODE). Avoids building against one interpreter and installing for
   another.

3. folly_python_cpp include order: the real folly source and binary roots are
   added BEFORE the cybld staging dir. cybld/folly/ holds symlinks named
   executor.h, iobuf.h, ... and on a case-insensitive filesystem (macOS
   default) `#include <folly/Executor.h>` resolved to cybld/folly/executor.h,
   i.e. folly/python/executor.h, breaking the build.

diff --git a/folly/python/CMakeLists.txt b/folly/python/CMakeLists.txt
index 673ab4cfa..99bc241f3 100644
--- a/folly/python/CMakeLists.txt
+++ b/folly/python/CMakeLists.txt
@@ -89,10 +89,22 @@ set(glog_lib "${GLOG_LIBRARY}")
 cmake_path(REMOVE_FILENAME glog_lib)
 set(libs "-L${CMAKE_CURRENT_BINARY_DIR}:${CMAKE_BINARY_DIR}:${glog_lib}")
 
+# Linker flags for the setup.py build_ext/bdist_wheel passes. On darwin there
+# is no ld.so.conf and DYLD_LIBRARY_PATH is not inherited by python, so the
+# extension modules carry an rpath to the directory libfolly/libfolly_python_cpp
+# are installed to (their install names are @rpath/...). The headerpad lets
+# install_name_tool rewrite/add load commands later if ever needed.
+set(_setup_py_ldflags "$ENV{LDFLAGS}")
+if(APPLE)
+  string(APPEND _setup_py_ldflags
+    " -Wl,-headerpad_max_install_names"
+    " -Wl,-rpath,${CMAKE_INSTALL_PREFIX}/${LIB_INSTALL_DIR}")
+endif()
+
 # Generate API headers only (no linking)
 add_custom_command(
   OUTPUT ${_cybld}/folly/iobuf_api.h
-  COMMAND python3 ${CMAKE_CURRENT_SOURCE_DIR}/setup.py --api-only
+  COMMAND ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/setup.py --api-only
   DEPENDS create_binding_symlink
   WORKING_DIRECTORY ${_cybld}
 )
@@ -128,6 +140,11 @@ add_dependencies(folly_python_cpp folly create_post_binding_symlink)
 set_property(TARGET folly_python_cpp PROPERTY VERSION ${PACKAGE_VERSION})
 target_compile_definitions(folly_python_cpp PRIVATE BOOST_NO_AUTO_PTR)
 target_include_directories(folly_python_cpp PRIVATE "${_cybld}")
+# The real folly source/binary roots must be searched BEFORE the cybld staging
+# dir: on a case-insensitive filesystem (macOS default) <folly/Executor.h>
+# would otherwise resolve to the folly/python/executor.h symlinked into cybld.
+target_include_directories(folly_python_cpp BEFORE PRIVATE
+  "${CMAKE_SOURCE_DIR}" "${CMAKE_BINARY_DIR}")
 target_link_libraries(folly_python_cpp PUBLIC folly)
 apply_folly_compile_options_to_target(folly_python_cpp)
 
@@ -143,7 +160,8 @@ add_custom_command(TARGET folly_python_bindings POST_BUILD
     "CXXFLAGS=${CMAKE_CXX_FLAGS}"
     "CC=${CMAKE_C_COMPILER}"
     "CXX=${CMAKE_CXX_COMPILER}"
-    python3 ${CMAKE_CURRENT_SOURCE_DIR}/setup.py
+    "LDFLAGS=${_setup_py_ldflags}"
+    ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/setup.py
     build_ext -f ${incs} ${libs}
   WORKING_DIRECTORY ${_cybld}
 )
@@ -168,7 +186,8 @@ add_custom_command(TARGET folly_python_bindings
     "CXXFLAGS=${CMAKE_CXX_FLAGS}"
     "CC=${CMAKE_C_COMPILER}"
     "CXX=${CMAKE_CXX_COMPILER}"
-    python3 ${CMAKE_CURRENT_SOURCE_DIR}/setup.py
+    "LDFLAGS=${_setup_py_ldflags}"
+    ${Python3_EXECUTABLE} ${CMAKE_CURRENT_SOURCE_DIR}/setup.py
     bdist_wheel
   WORKING_DIRECTORY ${_cybld}
 )
@@ -190,7 +209,7 @@ install(CODE "
   file(GLOB _folly_wheel \"${_cybld}/dist/folly-*.whl\")
   if(_folly_wheel)
     execute_process(
-      COMMAND python3 -m pip install \${_folly_wheel}
+      COMMAND ${Python3_EXECUTABLE} -m pip install \${_folly_wheel}
         --prefix ${INSTALL_DIR}
         --no-deps
         --force-reinstall
