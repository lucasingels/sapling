[manifest]
name = wangle-python
fbsource_path = fbcode/wangle
shipit_project = wangle
shipit_fbcode_builder = true

[git]
repo_url = https://github.com/facebook/wangle.git

[build]
builder = cmake
subdir = wangle

# Linux-only upstream; enabled on darwin for this fork so fbthrift-python
# (edenfsctl.real's thrift-python runtime) can link against the shared
# folly-python instead of a brew keg built against a different folly.
[build.os=windows]
builder = nop

[cmake.defines.test=on]
BUILD_TESTS=ON

[cmake.defines.test=off]
BUILD_TESTS=OFF

[cmake.defines.os=linux]
CMAKE_POSITION_INDEPENDENT_CODE = ON
BUILD_SHARED_LIBS = ON

# darwin: static PIC archives; they get linked into libthrift_python_cpp.dylib.
[cmake.defines.os=darwin]
CMAKE_POSITION_INDEPENDENT_CODE = ON

[dependencies]
folly-python
googletest
fizz-python

[shipit.pathmap]
fbcode/wangle/public_tld = .
fbcode/wangle = wangle
